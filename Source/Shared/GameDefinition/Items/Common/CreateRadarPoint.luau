local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local radarPoint = ReplicatedStorage.Assets.RadarPoint

type RadarPoint = typeof(radarPoint)

local module = {}

function module.RemoveRadarPoints(name: string): ()
    for _, v in workspace.RadarPoints:GetChildren() do
        if v.Name == name then
            v:Destroy()
        end
    end
end

-- Shamelessly generated by ChatGPT, because feck euler math
local function uprightCFrame(sourceCF: CFrame): CFrame
    local position = sourceCF.Position
    local forward = sourceCF.LookVector

    -- Remove any vertical component from the look vector
    forward = Vector3.new(forward.X, 0, forward.Z)

    -- If forward becomes zero (e.g., source is facing perfectly up/down), set a default forward
    if forward.Magnitude < 0.01 then
        forward = Vector3.new(0, 0, -1)
    end

    forward = forward.Unit
    local up = Vector3.new(0, 1, 0)
    local right = up:Cross(forward)

    return CFrame.fromMatrix(position, right, up)
end

local function CreateRadarPoint(cFrame: CFrame, colour: Color3, name: string?): RadarPoint
	cFrame = uprightCFrame(cFrame)

    local clone = radarPoint:Clone()
    clone:PivotTo(cFrame)

    local ui = clone.RadarPoint
    ui.TextLabel.Text = tostring(math.round(Players.LocalPlayer:DistanceFromCharacter(cFrame.Position)))

	ui.ImageLabel.ImageColor3 = colour
	ui.TextLabel.TextColor3 = colour
	clone.Highlight.FillColor = colour
	clone.Highlight.OutlineColor = colour

    ui.Enabled = true

	clone.Name = name or "RadarPoint"

    clone.Parent = workspace.RadarPoints :: any

	return clone
end

setmetatable(module, {
    __call = function(self, cFrame: CFrame, colour: Color3, name: string?): RadarPoint
        return CreateRadarPoint(cFrame, colour, name)
    end
})

return module